rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function applicationPath(uid) { return /databases/$(database)/documents/applications/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function role() { return get(userPath(request.auth.uid)).data.role; }
    function isMaster() { return hasProfile() && role() in ['master', 'owner']; }
    function isOwner() { return hasProfile() && role() == 'owner'; }
    function isActivePlayer() {
      return hasProfile() && role() == 'player' &&
        get(userPath(request.auth.uid)).data.status == 'active';
    }
    function canReadBroadcast() {
      return isMaster() || resource.data.audience == 'all' ||
        (signedIn() && resource.data.visibleTo is list && request.auth.uid in resource.data.visibleTo);
    }
    function canReadBroadcastData(data) {
      return isMaster() || data.audience == 'all' ||
        (signedIn() && data.visibleTo is list && request.auth.uid in data.visibleTo);
    }

    match /users/{uid} {
      allow get: if own(uid) || isOwner();
      allow list: if isMaster();
      allow create: if own(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'player' &&
        request.resource.data.status == 'visitor' &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner() || (isMaster() &&
        request.resource.data.role == resource.data.role &&
        (request.resource.data.status != 'active' ||
          (existsAfter(applicationPath(uid)) && getAfter(applicationPath(uid)).data.status == 'approved')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'squadId', 'updatedAt', 'updatedBy'
        ])) || (own(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ]));
      allow delete: if false;
    }

    match /applications/{uid} {
      allow get: if own(uid) || isMaster();
      allow list: if isMaster();
      allow create: if own(uid) &&
        request.resource.data.applicantUid == uid &&
        request.resource.data.submittedBy == uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.squadName is string &&
        request.resource.data.callSign is string &&
        request.resource.data.members is list &&
        request.resource.data.members.size() > 0 &&
        request.resource.data.members.size() <= 8 &&
        request.resource.data.keys().hasOnly([
          'applicantUid', 'submittedBy', 'squadName', 'callSign', 'members',
          'status', 'decisionReason', 'submittedAt', 'updatedAt'
        ]) &&
        get(userPath(uid)).data.role == 'player' &&
        get(userPath(uid)).data.status in ['visitor'];
      allow update: if (isMaster() &&
        request.resource.data.applicantUid == resource.data.applicantUid &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decisionReason', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ])) || (own(uid) &&
        resource.data.status == 'rejected' &&
        request.resource.data.applicantUid == uid &&
        request.resource.data.submittedBy == uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'squadName', 'callSign', 'members', 'status', 'submittedAt', 'updatedAt', 'submittedBy', 'decisionReason'
        ]));
      allow delete: if isMaster();
    }

    match /public/{document} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isMaster();
      allow update, delete: if isMaster();
      match /comments/{commentId} {
        allow read: if true;
        allow create: if (isActivePlayer() || isMaster()) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['authorUid', 'displayName', 'text', 'createdAt']);
        allow update, delete: if isMaster() ||
          (isActivePlayer() && resource.data.authorUid == request.auth.uid);
      }
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if (isActivePlayer() || isMaster()) && own(uid) &&
          request.resource.data.keys().hasOnly(['authorUid', 'value', 'updatedAt']) &&
          request.resource.data.authorUid == request.auth.uid;
        allow delete: if isActivePlayer() && own(uid);
      }
    }

    match /masterNotes/{uid} {
      allow get, list: if isMaster();
      allow create, update: if isMaster() &&
        request.resource.data.uid == uid &&
        request.resource.data.alias is string && request.resource.data.alias.size() <= 80 &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'alias', 'updatedBy', 'updatedAt']);
      allow delete: if isMaster();
    }

    match /broadcasts/{broadcastId} {
      allow get, list: if canReadBroadcast();
      allow create: if isMaster() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.senderName is string && request.resource.data.senderName.size() > 0 && request.resource.data.senderName.size() <= 80 &&
        request.resource.data.channel is string && request.resource.data.channel.size() > 0 && request.resource.data.channel.size() <= 40 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 12000 &&
        request.resource.data.audience in ['all', 'selected'] &&
        request.resource.data.visibleTo is list && request.resource.data.visibleTo.size() <= 100 &&
        ((request.resource.data.audience == 'all' && request.resource.data.visibleTo.size() == 0) ||
          (request.resource.data.audience == 'selected' && request.resource.data.visibleTo.size() > 0)) &&
        request.resource.data.status == 'Событие' &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'senderName', 'channel', 'text', 'imageUrl', 'audience', 'visibleTo',
          'status', 'createdAt', 'updatedAt'
        ]);
      allow update, delete: if isMaster();

      match /comments/{commentId} {
        function canReadParentBroadcast() {
          return canReadBroadcastData(get(/databases/$(database)/documents/broadcasts/$(broadcastId)).data);
        }
        allow get, list: if canReadParentBroadcast();
        allow create: if canReadParentBroadcast() && (isActivePlayer() || isMaster()) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.keys().hasOnly(['authorUid', 'displayName', 'text', 'createdAt']);
        allow update, delete: if canReadParentBroadcast() && (isMaster() ||
          (isActivePlayer() && resource.data.authorUid == request.auth.uid));
      }
    }

    match /privateMapMarkers/{markerId} {
      allow get, list: if isMaster() ||
        (signedIn() && resource.data.visibleTo is list && request.auth.uid in resource.data.visibleTo);
      allow create, update: if isMaster() &&
        request.resource.data.x is number && request.resource.data.y is number &&
        request.resource.data.symbol is string && request.resource.data.symbol.size() <= 32 &&
        request.resource.data.title is string && request.resource.data.title.size() <= 100 &&
        request.resource.data.caption is string && request.resource.data.caption.size() <= 48 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 1000 &&
        request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$') &&
        request.resource.data.visibleTo is list && request.resource.data.visibleTo.size() > 0 &&
        request.resource.data.visibleTo.size() <= 100 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'x', 'y', 'symbol', 'title', 'caption', 'description', 'color', 'visibleTo',
          'createdBy', 'createdAt', 'updatedAt'
        ]);
      allow delete: if isMaster();
    }

    match /orders/{orderId} {
      allow read: if isMaster() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isActivePlayer() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'Ожидает вердикта' &&
        request.resource.data.squadId == request.auth.uid &&
        request.resource.data.text is string && request.resource.data.text.size() <= 24000 &&
        request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'squadId', 'squadName', 'text', 'imageUrl', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update: if isMaster() ||
        (hasProfile() && role() == 'player' && resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 24000);
      allow delete: if isMaster() || (hasProfile() && role() == 'player' && resource.data.authorUid == request.auth.uid);
    }

    match /orderMedia/{mediaId} {
      function canReadMedia() {
        return isMaster() || (signedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.get('readerUid', '') == request.auth.uid));
      }
      allow read: if canReadMedia();
      allow create: if (isActivePlayer() || isMaster()) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.get('readerUid', '') is string && request.resource.data.get('readerUid', '').size() <= 128 &&
        (request.resource.data.get('readerUid', '') == '' || isMaster()) &&
        request.resource.data.ready == false &&
        request.resource.data.bytes is int && request.resource.data.bytes > 0 &&
        request.resource.data.bytes <= 12582912 &&
        request.resource.data.count is int && request.resource.data.count > 0 &&
        request.resource.data.count <= 48 &&
        request.resource.data.mime is string && request.resource.data.name is string &&
        request.resource.data.keys().hasOnly(['ownerUid', 'readerUid', 'mime', 'name', 'bytes', 'count', 'ready', 'createdAt']);
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']) &&
        request.resource.data.ready == true;
      allow delete: if isMaster() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      match /chunks/{chunkId} {
        function media() { return get(/databases/$(database)/documents/orderMedia/$(mediaId)).data; }
        allow read: if isMaster() || (signedIn() && (media().ownerUid == request.auth.uid || media().get('readerUid', '') == request.auth.uid));
        allow create: if signedIn() && media().ownerUid == request.auth.uid && media().ready == false &&
          request.resource.data.keys().hasOnly(['data']) &&
          request.resource.data.data is string && request.resource.data.data.size() <= 400000;
        allow delete: if isMaster() || (signedIn() && media().ownerUid == request.auth.uid);
      }
    }
  }
}

